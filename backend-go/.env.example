DATABASE_URL=postgres://feedinghands:choose-a-password@localhost:5432/feedinghands?sslmode=disable
PORT=5001
# At least 32 characters. Generate one with: openssl rand -base64 32
JWT_SECRET=
# Comma-separated frontend origins. Required in production.
CORS_ORIGIN=http://localhost:3000
# "production" turns on: OTPs only by email, HSTS, and refusing unsafe settings below.
APP_ENV=development
# true = create the demo personas (3 per role, password Demo@1234). Never in production.
SEED_DEMO_DATA=true
# true when running behind a reverse proxy (Railway, Render) so rate limits see real client IPs.
TRUST_PROXY=false

# Email for OTP codes. Required in production; without it, development logs OTPs to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FeedingHands <no-reply@example.com>
